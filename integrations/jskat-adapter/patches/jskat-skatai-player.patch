diff --git a/jskat-base/src/test/java/org/jskat/control/SkatTableLifecycleTest.java b/jskat-base/src/test/java/org/jskat/control/SkatTableLifecycleTest.java
new file mode 100644
index 0000000..1cd385f
--- /dev/null
+++ b/jskat-base/src/test/java/org/jskat/control/SkatTableLifecycleTest.java
@@ -0,0 +1,36 @@
+package org.jskat.control;
+
+import org.jskat.ai.test.UnitTestPlayer;
+import org.jskat.data.SkatTableOptions;
+import org.junit.jupiter.api.Test;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+class SkatTableLifecycleTest {
+
+    private static final class CloseablePlayer extends UnitTestPlayer implements AutoCloseable {
+        private boolean closed;
+
+        @Override
+        public void close() {
+            closed = true;
+        }
+    }
+
+    @Test
+    void removePlayersClosesAutoCloseablePlayers() {
+        SkatTableOptions options = new SkatTableOptions();
+        options.setMaxPlayerCount(3);
+        SkatTable table = new SkatTable("lifecycle-test", options);
+        CloseablePlayer player = new CloseablePlayer();
+        player.setPlayerName("closeable-test-player");
+
+        assertThat(table.placePlayer(player)).isTrue();
+        assertThat(table.getPlayerCount()).isEqualTo(1);
+
+        table.removePlayers();
+
+        assertThat(player.closed).isTrue();
+        assertThat(table.getPlayerCount()).isZero();
+    }
+}
